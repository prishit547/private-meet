# Server Port & Host
PORT=7842
HOST=0.0.0.0

# Vite Client URL (for CORS during development)
CLIENT_URL=http://localhost:5173

# HTTPS Configuration (Required when accessing via LAN or remote IP)
# Modern browsers require HTTPS for getUserMedia (mic/cam) and getDisplayMedia (screen share)
# outside of localhost.
USE_HTTPS=false
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Optional Private TURN Server (e.g. self-hosted coturn)
# For local LAN or open NATs, standard STUN is sufficient.
# TURN_SERVER_URL=turn:your-domain-or-ip:3478
# TURN_USERNAME=your_username
# TURN_PASSWORD=your_password
